{
  "schemaVersion": 1,
  "id": "coreySean.warp-vpn",
  "name": "WARP VPN",
  "version": "2.0.0",
  "author": "coreySean",
  "license": "MIT",
  "description": "Cloudflare WARP VPN bar widget: connect, disconnect and switch operation mode.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "WARP VPN",
    "description": "Toggle Cloudflare WARP and switch between operation modes.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "pollIntervalSec": 4,
      "showGlobalIp": true,
      "ipRefreshSec": 60
    },
    "schema": [
      {
        "key": "pollIntervalSec",
        "type": "integer",
        "label": "Poll interval (seconds)",
        "min": 2,
        "max": 300,
        "step": 1,
        "defaultValue": 4
      },
      {
        "key": "showGlobalIp",
        "type": "boolean",
        "label": "Look up the global IP address",
        "defaultValue": true
      },
      {
        "key": "ipRefreshSec",
        "type": "integer",
        "label": "Global IP refresh interval (seconds)",
        "min": 30,
        "max": 1800,
        "step": 30,
        "defaultValue": 60
      }
    ]
  }
}
